// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider               = "prisma-client-js"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "js"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// Enumeración para roles de usuario
enum RolUsuario {
  ADMINISTRADOR
  ABOGADO
  ASISTENTE_LEGAL
}

// Enumeración para estados de caso
enum EstadoCaso {
  TRAMITE
  EN_PROCESO
  FINALIZADO
  ARCHIVADO
}

// Enumeración para estados de audiencia
enum EstadoAudiencia {
  PENDIENTE
  REALIZADA
  CANCELADA
}

// Usuario profesional del sistema
model Usuario {
  id        Int        @id @default(autoincrement())
  nombre    String     @db.VarChar(100)
  correo    String     @unique @db.VarChar(150)
  clave     String     @db.VarChar(255)
  rol       RolUsuario @default(ASISTENTE_LEGAL)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relaciones
  casos                  Caso[]
  casosAsignados         CasoResponsable[]
  audiencias             Audiencia[]
  citas                  Cita[]
  recordatorios          Recordatorio[]
  reunionesCreadas       Reunion[]
  participacionesReunion ParticipanteReunion[]
}

// Clientes del estudio jurídico
model Cliente {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(150)
  correo      String   @unique @db.VarChar(150)
  telefono    String   @db.VarChar(20)
  direccion   String?  @db.Text
  idOperacion String?  @unique @db.VarChar(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  casos                  Caso[]
  participacionesReunion ParticipanteReunion[]
}

// Casos jurídicos
model Caso {
  id          Int        @id @default(autoincrement())
  numero      String     @unique @db.VarChar(50)
  asunto      String     @db.Text
  tipo        String     @db.VarChar(50)
  estado      EstadoCaso @default(TRAMITE)
  fechaInicio DateTime
  fechaCierre DateTime?
  usuarioId   Int
  clienteId   Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relaciones
  usuario       Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente       Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  audiencias    Audiencia[]
  citas         Cita[]
  recordatorios Recordatorio[]
  responsables  CasoResponsable[]
  reuniones     Reunion[]
}

// Profesionales responsables de cada caso
model CasoResponsable {
  id          Int      @id @default(autoincrement())
  casoId      Int
  usuarioId   Int
  esPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relaciones
  caso    Caso    @relation(fields: [casoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([casoId, usuarioId])
}

// Audiencias jurídicas
model Audiencia {
  id            Int             @id @default(autoincrement())
  fecha         DateTime
  lugar         String          @db.VarChar(200)
  estado        EstadoAudiencia @default(PENDIENTE)
  observaciones String?         @db.Text
  casoId        Int
  usuarioId     Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relaciones
  caso    Caso    @relation(fields: [casoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// Citas
model Cita {
  id        Int      @id @default(autoincrement())
  fecha     DateTime
  asunto    String   @db.Text
  contacto  String   @db.VarChar(100)
  casoId    Int?
  usuarioId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  caso    Caso?   @relation(fields: [casoId], references: [id], onDelete: SetNull)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// Recordatorios
model Recordatorio {
  id         Int      @id @default(autoincrement())
  titulo     String   @db.VarChar(100)
  mensaje    String   @db.Text
  fechaEnvio DateTime
  leido      Boolean  @default(false)
  casoId     Int?
  usuarioId  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relaciones
  caso    Caso?   @relation(fields: [casoId], references: [id], onDelete: SetNull)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// Reuniones que pueden o no estar asociadas a un caso
model Reunion {
  id            Int      @id @default(autoincrement())
  titulo        String   @db.VarChar(150)
  fecha         DateTime
  lugar         String?  @db.VarChar(200)
  observaciones String?  @db.Text
  casoId        Int?
  creadorId     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones
  caso          Caso?                 @relation(fields: [casoId], references: [id], onDelete: SetNull)
  creador       Usuario               @relation(fields: [creadorId], references: [id], onDelete: Cascade)
  participantes ParticipanteReunion[]
}

// Participantes de una reunión:
// pueden ser usuarios del sistema, clientes o personas externas
model ParticipanteReunion {
  id            Int     @id @default(autoincrement())
  reunionId     Int
  usuarioId     Int?
  clienteId     Int?
  nombreExterno String? @db.VarChar(150)
  correoExterno String? @db.VarChar(150)

  // Relaciones
  reunion Reunion  @relation(fields: [reunionId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
}
